#pragma once

// Generated by CMake from project(VERSION) in CMakeLists.txt. pyproject.toml
// and retrolarium_core/__init__.py carry the same number
// (tests/python/test_version.py), and the Python bridge refuses an rlcore that
// reports another.

namespace retrolarium::core {

inline constexpr char kVersion[] = "@RetrolariumCore_VERSION@";

}  // namespace retrolarium::core

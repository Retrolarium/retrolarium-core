schema = "retrolarium.project"
schema_version = 1

[project]
id = "smb1-ju"
name = "Super Mario Bros. — Тест"
platform = "nes"
profile = "smb1"
source_mode = "source-project"

[source]
disassembly = "disassembly/manifest.json"
sha256 = "2e3b9b749cf26d221642000d503245debc97955357d42a57f9e463b76dfe3896"

[workspace]
layout = "two-row"
startup_tab = "graphics"

[[workspace.tabs]]
id = "graphics"
title = "Graphics"
kind = "graphics.tile-set"
group = "assets"
codec = "nes.chr-4bpp.v1"
document = "documents/graphics.toml"
capabilities = ["pixel-paint", "undo"]

[[workspace.tabs]]
id = "levels"
title = "Levels"
kind = "level.tile-grid"
group = "content"
codec = "smb.levels.v1"
document = "documents/levels.toml"
capabilities = ["paint", "navigate"]
depends_on = ["graphics"]

[[workspace.tabs]]
id = "analysis"
title = "Disassembly"
kind = "code.analysis"
group = "tools"
codec = "retrolarium.nes.disassembly@1"

[[workspace.tabs]]
id = "music"
title = "Music"
kind = "audio.sequencer"
group = "content"
codec = "smb.apu-music.v1"
document = "documents/music.toml"
enabled = false

[operations]
build = "project.build"
validate = "project.validate"
launch = "project.launch"
verify = "project.verify"

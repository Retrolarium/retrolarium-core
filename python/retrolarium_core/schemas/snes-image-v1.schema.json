{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Retrolarium/retrolarium-core/main/python/retrolarium_core/schemas/snes-image-v1.schema.json",
  "title": "Retrolarium SNES cartridge image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "source",
    "container_size",
    "container_sha256",
    "copier_header_size",
    "rom_size",
    "rom_sha256",
    "cpu",
    "byte_order",
    "mapping",
    "header_offset",
    "header",
    "reset_vector",
    "reset_address",
    "reset_rom_offset",
    "regions",
    "bus_windows",
    "vectors",
    "warnings"
  ],
  "properties": {
    "schema": {"const": "retrolarium.snes.image"},
    "schema_version": {"const": 1},
    "source": {"type": ["string", "null"]},
    "container_size": {"type": "integer", "minimum": 32768},
    "container_sha256": {"$ref": "#/$defs/sha256"},
    "copier_header_size": {"enum": [0, 512]},
    "rom_size": {"type": "integer", "minimum": 32768, "maximum": 4194304, "multipleOf": 32768},
    "rom_sha256": {"$ref": "#/$defs/sha256"},
    "cpu": {"const": "w65c816"},
    "byte_order": {"const": "little"},
    "mapping": {"enum": ["lorom", "hirom"]},
    "header_offset": {"enum": [32704, 65472]},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "map_mode_byte", "map_mode", "speed", "chipset", "rom_size_code", "declared_rom_size", "ram_size_code", "declared_ram_size", "region_code", "developer_id", "version", "checksum_complement", "checksum", "computed_checksum", "checksum_status"],
      "properties": {
        "title": {"type": "string"},
        "map_mode_byte": {"enum": [32, 33, 48, 49]},
        "map_mode": {"enum": ["lorom", "hirom"]},
        "speed": {"enum": ["slow", "fast"]},
        "chipset": {"enum": [0, 1, 2]},
        "rom_size_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "declared_rom_size": {"type": "integer", "minimum": 1},
        "ram_size_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "declared_ram_size": {"type": "integer", "minimum": 0},
        "region_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "developer_id": {"type": "integer", "minimum": 0, "maximum": 255},
        "version": {"type": "integer", "minimum": 0, "maximum": 255},
        "checksum_complement": {"type": "integer", "minimum": 0, "maximum": 65535},
        "checksum": {"type": "integer", "minimum": 0, "maximum": 65535},
        "computed_checksum": {"type": "integer", "minimum": 0, "maximum": 65535},
        "checksum_status": {"enum": ["valid", "absent", "invalid-pair", "mismatch"]}
      }
    },
    "reset_vector": {"type": "integer", "minimum": 32768, "maximum": 65535},
    "reset_address": {"type": "integer", "minimum": 32768, "maximum": 65535},
    "reset_rom_offset": {"type": "integer", "minimum": 0},
    "regions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/region"}},
    "bus_windows": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/bus_window"}},
    "vectors": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/vector"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "container_offset", "rom_offset", "size", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "container_offset": {"type": "integer", "minimum": 0},
        "rom_offset": {"type": ["integer", "null"], "minimum": 0},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bus_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "bank_start", "bank_end", "address_start", "address_end"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["rom", "wram", "sram"]},
        "bank_start": {"type": "integer", "minimum": 0, "maximum": 255},
        "bank_end": {"type": "integer", "minimum": 0, "maximum": 255},
        "address_start": {"type": "integer", "minimum": 0, "maximum": 65535},
        "address_end": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "index", "name", "raw_value", "cpu_address", "rom_offset"],
      "properties": {
        "mode": {"enum": ["native", "emulation"]},
        "index": {"type": "integer", "minimum": 0, "maximum": 7},
        "name": {"type": "string", "minLength": 1},
        "raw_value": {"type": "integer", "minimum": 0, "maximum": 65535},
        "cpu_address": {"type": ["integer", "null"], "minimum": 32768, "maximum": 65535},
        "rom_offset": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrolarium.dev/schemas/snes-disassembly-v1.schema.json",
  "title": "Retrolarium SNES disassembly project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "task", "mode", "input", "analysis",
    "pointers", "symbols", "cross_cpu_evidence", "assets", "source",
    "operations", "verification"
  ],
  "properties": {
    "schema": { "const": "retrolarium.snes.disassembly" },
    "schema_version": { "const": 1 },
    "task": { "const": "snes.disassemble" },
    "mode": { "const": "blind" },
    "input": {
      "type": "object",
      "required": [
        "schema", "schema_version", "container_sha256", "container_size",
        "rom_sha256", "rom_size", "copier_header_size", "byte_order", "cpu",
        "mapping", "header", "vectors", "regions", "bus_windows"
      ],
      "properties": {
        "schema": { "const": "retrolarium.snes.image" },
        "schema_version": { "const": 1 },
        "container_sha256": { "$ref": "#/$defs/sha256" },
        "container_size": { "type": "integer", "minimum": 32768 },
        "rom_sha256": { "$ref": "#/$defs/sha256" },
        "rom_size": { "type": "integer", "minimum": 32768 },
        "copier_header_size": { "enum": [0, 512] },
        "byte_order": { "const": "little" },
        "cpu": { "const": "w65c816" },
        "mapping": { "enum": ["lorom", "hirom"] }
      }
    },
    "analysis": { "$ref": "#/$defs/hashedArtifact" },
    "pointers": { "$ref": "#/$defs/hashedArtifact" },
    "symbols": { "$ref": "#/$defs/hashedArtifact" },
    "cross_cpu_evidence": { "$ref": "#/$defs/hashedArtifact" },
    "assets": {
      "type": "object",
      "required": ["schema", "schema_version", "items"],
      "properties": {
        "schema": { "const": "retrolarium.assets" },
        "schema_version": { "const": 1 },
        "items": { "type": "array" }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "dialect", "directory", "units", "header_unit", "coverage",
        "whole_rom_fallback", "emission"
      ],
      "properties": {
        "dialect": { "const": "ca65" },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "whole_rom_fallback": { "const": false },
        "coverage": {
          "type": "object",
          "required": [
            "rom_bytes", "copier_header_bytes", "instruction_bytes",
            "instruction_fallback_bytes", "pointer_bytes", "header_bytes",
            "raw_bytes"
          ]
        }
      }
    },
    "operations": {
      "type": "object",
      "required": ["build", "verify", "launch"]
    },
    "verification": {
      "type": "object",
      "required": ["status"]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedArtifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

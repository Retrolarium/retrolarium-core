# Sources are LF everywhere: the studio builds the core in bash inside Docker.
*.cpp           text eol=lf
*.hpp           text eol=lf
*.h             text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf
# Fixtures are compared byte for byte (a CRLF checkout would fail the
# parity tests): LF too.
*.json          text eol=lf
*.txt           text eol=lf
*.rlj           text eol=lf
*.toml          text eol=lf
*.asm           text eol=lf
*.sha256        text eol=lf
Makefile        text eol=lf
*.bin           binary
*.mid           binary
